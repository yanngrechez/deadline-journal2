{
  "name": "deadline-journal2",
  "compatibility_date": "2026-08-28",
  "main": ".cloudflare/worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/article", "/article.html", "/article/", "/article.html/",
      "/country", "/country.html", "/country/", "/country.html/",
      "/region", "/region.html", "/region/", "/region.html/",
      "/*/", "/*/index.html", "/*.html"
    ]
  }
}
